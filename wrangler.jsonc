
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zen-cafe",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "GALLERY_BUCKET",
      "bucket_name": "zencafe-gallery"
    }
  ],
  "triggers": {
    "crons": [
      
    ]
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://zencafe.lk",
    "API_V2_URL": "https://api-v2.zencafe.lk",
    "RESEND_FROM_EMAIL":  "Zen Café <noreply@zencafe.lk>"
  }
}
