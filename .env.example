# ==============================================================================
# ZEN CAFÉ — PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env for local Node backend execution.
# For Cloudflare Worker production deployment, see DEPLOYMENT_GUIDE.md.
# NEVER commit real passwords or production tokens into version control.

# ------------------------------------------------------------------------------
# 1. Local Node HTTP Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Hostinger VPS PostgreSQL Configuration (zencafe_db)
# ------------------------------------------------------------------------------
# In local development via secure SSH tunnel to VPS (e.g. port 55432):
# ssh -N -L 55432:127.0.0.1:5432 root@<VPS_IP>
DATABASE_URL=postgresql://zencafe_app:your_db_password_here@127.0.0.1:55432/zencafe_db?sslmode=disable

# Or via individual PostgreSQL parameters:
PGHOST=127.0.0.1
PGPORT=55432
PGUSER=zencafe_app
PGPASSWORD=your_db_password_here
PGDATABASE=zencafe_db
PGSSLMODE=disable

# ------------------------------------------------------------------------------
# 3. Public Base URL & Web Origins
# ------------------------------------------------------------------------------
PUBLIC_BASE_URL=https://zencafe.lk

# ------------------------------------------------------------------------------
# 4. Email Notification Service (Resend)
# ------------------------------------------------------------------------------
# Obtain an API key from https://resend.com/api-keys
# Verify the sender domain (zencafe.lk) in Resend DNS settings.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Zen Café <bookings@zencafe.lk>

# ------------------------------------------------------------------------------
# 5. WhatsApp Cloud Notification Service (Meta Graph API)
# ------------------------------------------------------------------------------
# Obtain permanent access token and Phone Number ID from Meta for Developers.
WHATSAPP_API_TOKEN=your_meta_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
ADMIN_WHATSAPP_NUMBER=94771234567

# ------------------------------------------------------------------------------
# 6. Cloudflare R2 Storage (Optional for local Node server; configured via Workers)
# ------------------------------------------------------------------------------
# R2_BUCKET_NAME=zencafe-gallery
